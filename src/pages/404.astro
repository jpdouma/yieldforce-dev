---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found" description="The page you are looking for could not be found.">
  <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-28 text-center">
    <p class="text-sm font-semibold text-blue-400 mb-3">404</p>
    <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight mb-4">Page not found</h1>
    <p class="text-slate-400 mb-8">The page you are looking for does not exist or has moved.</p>
    <a href="/" class="inline-flex items-center justify-center px-6 py-3 text-sm font-semibold text-white bg-blue-600 hover:bg-blue-500 rounded-xl transition-all">Back to home</a>
  </div>
</Layout>
