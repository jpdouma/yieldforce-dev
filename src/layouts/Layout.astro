---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Yield Force — AI-powered sales automation for Shopify merchants. Instant customer answers on WhatsApp, Instagram, and Facebook 24/7."
} = Astro.props;
---

<!doctype html>
<html lang="en" class="h-full bg-[#0a0f1d] text-slate-100 antialiased">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | Yield Force</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={`${title} | Yield Force`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body class="min-h-full flex flex-col bg-[#0a0f1d] text-slate-200 selection:bg-blue-600 selection:text-white">
    <!-- Header -->
    <header class="border-b border-slate-800/80 bg-[#0a0f1d]/90 backdrop-blur sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center gap-3 group">
          <div class="w-8 h-8 rounded-lg bg-gradient-to-tr from-blue-600 to-indigo-500 flex items-center justify-center font-bold text-white shadow-md shadow-blue-500/20 group-hover:scale-105 transition-transform">
            Y
          </div>
          <span class="text-xl font-bold tracking-tight text-white group-hover:text-blue-400 transition-colors">Yield Force</span>
        </a>

        <nav class="hidden md:flex items-center gap-8 text-sm font-medium text-slate-300">
          <a href="/" class="hover:text-white transition-colors">Home</a>
          <a href="/data" class="hover:text-white transition-colors">Data Handling</a>
          <a href="/privacy" class="hover:text-white transition-colors">Privacy Policy</a>
          <a href="/terms" class="hover:text-white transition-colors">Terms of Service</a>
          <a href="/contact" class="hover:text-white transition-colors">Contact</a>
        </nav>

        <div class="flex items-center gap-3">
          <a
            href="/contact"
            class="inline-flex items-center justify-center px-4 py-2 text-sm font-semibold text-white bg-blue-600 hover:bg-blue-500 rounded-lg shadow-sm transition-all focus:outline-none focus:ring-2 focus:ring-blue-400 focus:ring-offset-2 focus:ring-offset-[#0a0f1d]"
          >
            Contact us
          </a>
        </div>
      </div>
      <!-- Mobile navigation sub-bar -->
      <div class="md:hidden border-t border-slate-800/60 px-4 py-2.5 flex items-center justify-between text-xs text-slate-300 overflow-x-auto space-x-4">
        <a href="/" class="whitespace-nowrap hover:text-white">Home</a>
        <a href="/data" class="whitespace-nowrap hover:text-white">Data</a>
        <a href="/privacy" class="whitespace-nowrap hover:text-white">Privacy</a>
        <a href="/terms" class="whitespace-nowrap hover:text-white">Terms</a>
        <a href="/contact" class="whitespace-nowrap hover:text-white">Contact</a>
      </div>
    </header>

    <!-- Main Content -->
    <main class="flex-grow">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-slate-800 bg-[#070a14] py-12 text-sm text-slate-400">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-8">
          <div class="md:col-span-2">
            <div class="flex items-center gap-3 mb-3">
              <div class="w-6 h-6 rounded-md bg-blue-600 flex items-center justify-center font-bold text-white text-xs">
                Y
              </div>
              <span class="text-base font-semibold text-white">Yield Force</span>
            </div>
            <p class="text-xs text-slate-400 max-w-sm leading-relaxed mb-3">
              AI-powered sales automation for Shopify merchants. Operating 24/7 across WhatsApp, Instagram, and Facebook with strict GDPR compliance and EU data residency.
            </p>
            <p class="text-xs text-slate-500">
              Gaia Holdings Limited · Registered in England and Wales
            </p>
          </div>

          <div>
            <h3 class="text-xs font-semibold text-slate-300 uppercase tracking-wider mb-3">Compliance & Trust</h3>
            <ul class="space-y-2 text-xs">
              <li><a href="/privacy" class="hover:text-white transition-colors">Privacy Policy</a></li>
              <li><a href="/terms" class="hover:text-white transition-colors">Terms of Service</a></li>
              <li><a href="/data" class="hover:text-white transition-colors">Data Handling Disclosure</a></li>
            </ul>
          </div>

          <div>
            <h3 class="text-xs font-semibold text-slate-300 uppercase tracking-wider mb-3">Connect</h3>
            <ul class="space-y-2 text-xs">
              <li><a href="/contact" class="hover:text-white transition-colors">Contact Support</a></li>
              <li><a href="mailto:dev@yieldforce.dev" class="hover:text-white transition-colors">dev@yieldforce.dev</a></li>
            </ul>
          </div>
        </div>

        <div class="border-t border-slate-800/80 pt-6 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-500 gap-4">
          <p>© 2026 Gaia Holdings Limited · Privacy Policy · Terms of Service · <a href="mailto:dev@yieldforce.dev" class="text-slate-400 hover:text-white transition-colors">dev@yieldforce.dev</a></p>
          <div class="flex items-center gap-4">
            <span class="inline-flex items-center gap-1.5 text-emerald-400">
              <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
              All Systems Operational
            </span>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
